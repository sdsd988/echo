{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(/prompts/**)",
      "Bash(cat prompts/*)",
      "Bash(cat /prompts/*)",
      "Bash(head prompts/*)",
      "Bash(head /prompts/*)",
      "Bash(tail prompts/*)",
      "Bash(tail /prompts/*)",
      "Bash(sed * prompts/*)",
      "Bash(sed * /prompts/*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(psql:*)",
      "Bash(docker:*)"
    ],
    "allow": [
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew bootRun:*)",
      "Bash(./gradlew :apps:customer-api:bootRun:*)",
      "Bash(./gradlew :apps:customer-api:test:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-follow-cross-import.sh\"",
            "timeout": 10,
            "statusMessage": "follow 모듈 의존성 검사 중…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/run-module-tests.sh\"",
            "timeout": 300,
            "statusMessage": "모듈 테스트 실행 중…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-summary.sh\"",
            "timeout": 15,
            "statusMessage": "세션 요약 기록 중…"
          }
        ]
      }
    ]
  }
}
