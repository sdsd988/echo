package com.echo.{{module}}.domain;

import jakarta.persistence.*;
import java.time.LocalDateTime;

/**
 * {{Domain}} 엔티티. domain 계층이므로 Spring 의존 없이 POJO + JPA만 사용한다.
 *
 * <p>불변식은 생성자에서 강제한다 — 위반 시 {@link IllegalArgumentException}을 던지고,
 * HTTP 상태(400 등) 변환은 컨트롤러(조립 지점)의 몫이다.
 *
 * <p>TODO: 아래 {@code value}는 골격용 예시 필드다. 실제 도메인 필드/제약/불변식으로 교체한다.
 */
@Entity
@Table(name = "{{module}}s")
public class {{Domain}} {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(nullable = false)
    private String value;

    @Column(nullable = false, updatable = false)
    private LocalDateTime createdAt;

    protected {{Domain}}() {
    }

    public {{Domain}}(String value) {
        if (value == null || value.isBlank()) {
            throw new IllegalArgumentException("value는 비어 있을 수 없습니다.");
        }
        this.value = value;
        this.createdAt = LocalDateTime.now();
    }

    public Long getId() { return id; }
    public String getValue() { return value; }
    public LocalDateTime getCreatedAt() { return createdAt; }
}
